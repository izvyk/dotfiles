#!/bin/sh
# Install the yazi plugins pinned in package.toml, again whenever it changes.
# package.toml: {{ include "private_dot_config/private_yazi/private_package.toml" | sha256sum }}
# --discard: an installed plugin whose pin moved looks "locally modified" to
# ya. Plugins come only from package.toml, so the pin wins.
command -v ya >/dev/null || exit 0
ya pkg install --discard || echo "yazi plugins not installed; run: ya pkg install --discard" >&2
