{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code settings: the shared ones from
  .chezmoitemplates/claude/settings.json, plus the model and its effort level
  from the existing file. Those are picked per machine in Claude Code
  (/model), which writes them here, so they are never stored in the repo.

  Claude Code rewrites this file in its own key order. While it still holds
  these settings it is left as it is, so that is not a diff.
*/ -}}
{{- $settings := includeTemplate "claude/settings.json" . | fromJson -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin | trim }}{{ $current = .chezmoi.stdin | fromJson }}{{ end -}}
{{- range $key := list "model" "modelSettings" -}}
{{-   if hasKey $current $key }}{{ $_ := set $settings $key (get $current $key) }}{{ end -}}
{{- end -}}
{{ if deepEqual $settings $current }}{{ .chezmoi.stdin }}{{ else }}{{ $settings | toPrettyJson }}{{ end -}}
