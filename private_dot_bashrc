# If not running interactively, don't do anything
[[ $- != *i* ]] && return

echo '
  ██  ██  ██  ██  ██  ██  ██  ██  ██
 ████████ ██ ████████ ██ ████████ ██
  ██  ██  ██  ██  ██  ██  ██  ██  ██
 ████████    ████████    ████████
  ██  ██  ██  ██  ██  ██  ██  ██  ██
'

PS1='\[\e[92m\]\u\[\e[0m\]@\h \[\e[92m\]\W\[\e[0m\] \\$ '

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# Aliases
alias ls='eza'
alias ll='eza -l'
alias la='eza -la'
alias ruman='LANG=ru_RU.UTF-8 man'

shopt -s autocd
shopt -s cdable_vars
shopt -s cdspell
shopt -s dirspell
shopt -s nocaseglob
shopt -s globstar
shopt -s checkjobs
shopt -s no_empty_cmd_completion
bind "set completion-ignore-case on"

# Ubuntu's /etc/bash.bashrc leaves this to ~/.bashrc
[[ -r /usr/share/bash-completion/bash_completion ]] && . /usr/share/bash-completion/bash_completion

command -v zoxide >/dev/null && eval "$(zoxide init --hook pwd --cmd cd bash)"

export GPG_TTY="$(tty)"

# bat is batcat on Debian/Ubuntu; the theme is in ~/.config/bat/config
bat=$(command -v bat || command -v batcat)
if [[ -n $bat ]]; then
    export MANPAGER="sh -c 'col -bx | $bat -l man -p'"
    export MANROFFOPT='-c' # Fix escape sequences in bat
    alias bat="$bat" cat="$bat"
fi
unset bat

umask 077

[[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || PATH="${PATH:+$PATH:}$HOME/.local/bin"
