# btop theme from the shared theme (.chezmoidata/theme.toml).
# Keys: btop's share/btop/themes/*.theme. Empty *_mid means a 2-colour gradient.
{{- $u := .theme.ui }}{{ $a := .theme.ansi }}{{ $x := .theme.extra }}
theme[main_bg]="{{ $u.bg }}"
theme[main_fg]="{{ $u.fg }}"
theme[title]="{{ $u.fg }}"
theme[hi_fg]="{{ $a.red }}"
theme[selected_bg]="{{ $u.bg1 }}"
theme[selected_fg]="{{ $a.bright_magenta }}"
theme[inactive_fg]="{{ $u.bg1 }}"
theme[graph_text]="{{ $u.fg_dim }}"
theme[proc_misc]="{{ $a.green }}"
theme[cpu_box]="{{ $u.fg_dim }}"
theme[mem_box]="{{ $u.fg_dim }}"
theme[net_box]="{{ $u.fg_dim }}"
theme[proc_box]="{{ $u.fg_dim }}"
theme[div_line]="{{ $u.fg_dim }}"
theme[temp_start]="{{ $a.green }}"
theme[temp_mid]=""
theme[temp_end]="{{ $a.red }}"
theme[cpu_start]="{{ $a.bright_cyan }}"
theme[cpu_mid]="{{ $a.yellow }}"
theme[cpu_end]="{{ $a.red }}"
theme[free_start]="{{ $a.red }}"
theme[free_mid]="{{ $a.yellow }}"
theme[free_end]="{{ $a.bright_cyan }}"
theme[cached_start]="{{ $a.blue }}"
theme[cached_mid]="{{ $a.bright_blue }}"
theme[cached_end]="{{ $a.bright_cyan }}"
theme[available_start]="{{ $a.red }}"
theme[available_mid]="{{ $x.orange }}"
theme[available_end]="{{ $a.bright_yellow }}"
theme[used_start]="{{ $a.bright_cyan }}"
theme[used_mid]="{{ $x.orange }}"
theme[used_end]="{{ $a.red }}"
theme[download_start]="{{ $a.green }}"
theme[download_mid]="{{ $a.cyan }}"
theme[download_end]="{{ $a.bright_green }}"
theme[upload_start]="{{ $a.red }}"
theme[upload_mid]="{{ $x.orange }}"
theme[upload_end]="{{ $a.bright_yellow }}"
theme[process_start]="{{ $a.bright_cyan }}"
theme[process_mid]="{{ $x.bright_orange }}"
theme[process_end]="{{ $a.red }}"
