font=Monospace:size=14
# shell=fish
selection-target=both
# pad=25x25 center                          # optionally append 'center'
initial-window-mode=maximized

[mouse]
hide-when-typing=yes

[colors-dark]
# alpha=0.95
alpha=0.85
blur=yes
# Colours from the shared theme (.chezmoidata/theme.toml); foot wants no "#".
{{- with .theme }}
foreground={{ .ui.fg | trimPrefix "#" }}
background={{ .ui.bg | trimPrefix "#" }}
cursor={{ .ui.bg | trimPrefix "#" }} {{ .ui.fg | trimPrefix "#" }}
selection-foreground={{ .ui.fg | trimPrefix "#" }}
selection-background={{ .ui.bg3 | trimPrefix "#" }}

regular0={{ .ansi.black | trimPrefix "#" }}
regular1={{ .ansi.red | trimPrefix "#" }}
regular2={{ .ansi.green | trimPrefix "#" }}
regular3={{ .ansi.yellow | trimPrefix "#" }}
regular4={{ .ansi.blue | trimPrefix "#" }}
regular5={{ .ansi.magenta | trimPrefix "#" }}
regular6={{ .ansi.cyan | trimPrefix "#" }}
regular7={{ .ansi.white | trimPrefix "#" }}

bright0={{ .ansi.bright_black | trimPrefix "#" }}
bright1={{ .ansi.bright_red | trimPrefix "#" }}
bright2={{ .ansi.bright_green | trimPrefix "#" }}
bright3={{ .ansi.bright_yellow | trimPrefix "#" }}
bright4={{ .ansi.bright_blue | trimPrefix "#" }}
bright5={{ .ansi.bright_magenta | trimPrefix "#" }}
bright6={{ .ansi.bright_cyan | trimPrefix "#" }}
bright7={{ .ansi.bright_white | trimPrefix "#" }}
{{- end }}

[key-bindings]
fullscreen=F11
scrollback-up-page=Page_Up
scrollback-down-page=Page_Down
search-start=Control+Shift+f

[search-bindings]
cancel=Escape
find-prev=Control+Shift+n
find-next=Control+n

[csd]
size=0
border-width=3
