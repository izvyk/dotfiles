# All options: `ghostty +show-config --default --docs`
font-family = Monospace
# Ghostty uses its built-in Noto emoji on Linux unless a font-family has emoji.
# Not installed on malvina; Ghostty skips it there.
font-family = Apple Emoji
font-size = 14
# Colours from the shared theme (.chezmoidata/theme.toml)
{{- with .theme }}
background = {{ .ui.bg }}
foreground = {{ .ui.fg }}
cursor-color = {{ .ui.fg }}
cursor-text = {{ .ui.bg }}
selection-background = {{ .ui.bg3 }}
selection-foreground = {{ .ui.fg }}
palette = 0={{ .ansi.black }}
palette = 1={{ .ansi.red }}
palette = 2={{ .ansi.green }}
palette = 3={{ .ansi.yellow }}
palette = 4={{ .ansi.blue }}
palette = 5={{ .ansi.magenta }}
palette = 6={{ .ansi.cyan }}
palette = 7={{ .ansi.white }}
palette = 8={{ .ansi.bright_black }}
palette = 9={{ .ansi.bright_red }}
palette = 10={{ .ansi.bright_green }}
palette = 11={{ .ansi.bright_yellow }}
palette = 12={{ .ansi.bright_blue }}
palette = 13={{ .ansi.bright_magenta }}
palette = 14={{ .ansi.bright_cyan }}
palette = 15={{ .ansi.bright_white }}
{{- end }}
maximize = true
# No titlebar (and no menu button): just the terminal. Super+drag moves the
# window; the menu's actions are in the command palette (Ctrl+Shift+P).
gtk-titlebar = false
background-opacity = 0.92
# Also for cells with their own background, or Neovim and tmux stay opaque.
background-opacity-cells = true
# Via ext-background-effect-v1: a no-op until the compositor supports it.
background-blur = true
# One process for all windows, however Ghostty was started (~16 MB per extra
# window instead of a new ~120 MB process). It still quits with the last window.
gtk-single-instance = true
cursor-style = bar
cursor-style-blink = false
custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl
mouse-hide-while-typing = true
# 3 lines per wheel notch, and a touchpad to match. Ghostty multiplies scroll
# deltas by GTK's integer scale (2 on HiDPI) and touchpad deltas by another 10.
mouse-scroll-multiplier = precision:0.15,discrete:1.5
right-click-action = copy-or-paste
# Shift+Enter is a new line, as in messengers: sent as Alt+Enter, which passes
# through tmux and ssh as is and is a new line in fish and Claude Code. Ctrl+Enter
# is plain Enter instead of toggling fullscreen (still in the command palette).
keybind = shift+enter=text:\x1b\r
keybind = ctrl+enter=unbind
clipboard-paste-protection = true

# ssh-env sends TERM=xterm-256color over ssh, so tmux, vim, htop etc. work on
# hosts without ghostty's terminfo. No ssh-terminfo: it tic's into ~/.terminfo
# on every new host, and fails on git hosts and hosts with RemoteCommand.
shell-integration-features = no-cursor,ssh-env
