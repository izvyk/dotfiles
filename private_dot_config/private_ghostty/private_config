# All options: `ghostty +show-config --default --docs`
font-family = Monospace
font-size = 14
theme = Gruvbox Dark
maximize = true
cursor-style = bar
cursor-style-blink = false
custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl
mouse-hide-while-typing = true
right-click-action = copy-or-paste
clipboard-paste-protection = true

# ssh-terminfo installs ghostty's terminfo on hosts you ssh into (falling back
# to xterm-256color via ssh-env), so tmux, vim, htop etc. work there.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
