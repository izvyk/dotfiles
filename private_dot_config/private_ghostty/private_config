# All options: `ghostty +show-config --default --docs`
font-family = Monospace
font-size = 14
theme = Gruvbox Dark
maximize = true
cursor-style = bar
cursor-style-blink = false
custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl
mouse-hide-while-typing = true
right-click-action = copy-or-paste
clipboard-paste-protection = true

# ssh-env sends TERM=xterm-256color over ssh, so tmux, vim, htop etc. work on
# hosts without ghostty's terminfo. No ssh-terminfo: it tic's into ~/.terminfo
# on every new host, and fails on git hosts and hosts with RemoteCommand.
shell-integration-features = no-cursor,ssh-env
