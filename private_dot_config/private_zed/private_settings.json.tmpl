// Zed settings. All options: `zed: open default settings` in the command palette.
// Zed also writes here (model pickers, theme selector, ...): review those with
// `chezmoi diff` and copy what you keep into the chezmoi template.
{{- /* buratino only, and only once the age key is on the machine (see .chezmoiignore). */}}
{{- $buratino := ne .chezmoi.hostname "malvina" }}
{{- $secrets := and $buratino (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt")) }}
{
  // Appearance
  "theme": {
    "mode": "system",
    "light": "Flexoki Light",
    // Generated from the shared palette: themes/dotfiles.json
    "dark": "Dotfiles",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark",
  },
  // Installed on first start, so a new machine looks the same.
  "auto_install_extensions": {
    "flexoki-themes": true,
    "colored-zed-icons-theme": true,
    "git-firefly": true,
    "go-snippets": true,
    "fish": true,
    "html": true,
    "ini": true,
    "lua": true,
    "make": true,
    "nix": true,
    "scss": true,
    "toml": true,
  },
  // No extension may run commands, download files or install npm packages
  // (Zed grants all three by default). Their prebuilt binaries don't run on
  // NixOS anyway: language servers come from the project's shell.nix (via
  // direnv) or the system. Zed still starts the language server an extension
  // names; this list doesn't limit that.
  "granted_extension_capabilities": [],
  "ui_font_size": 16,
  "agent_ui_font_size": 16.0,
  "buffer_font_family": "Iosevka Curly",
  "buffer_font_size": 17.0,
  "buffer_font_weight": 400.0,
  "buffer_line_height": "standard",
{{- if $buratino }}
  // Zed's built-in emoji fallback looks for "Noto Color Emoji" by name and
  // ignores fontconfig, so name the renamed Apple font (nixos-config) explicitly.
  "buffer_font_fallbacks": ["Apple Emoji"],
  "ui_font_fallbacks": ["Apple Emoji"],
{{- end }}
  "title_bar": {
    "show_menus": false,
  },
  "minimap": {
    "show": "auto",
  },
  "scrollbar": {
    "show": "auto",
  },
  "show_wrap_guides": true,

  // Editing
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "soft_wrap": "editor_width",
  "cursor_shape": "bar",
  "cursor_blink": false,
  "current_line_highlight": "all",
  "rounded_selection": true,
  "vertical_scroll_margin": 5.0,
  "autoscroll_on_clicks": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 2000,
    },
  },
  "prettier": {
    "allowed": true,
  },
  "load_direnv": "shell_hook",
  "cli_default_open_behavior": "existing_window",

  // Panels
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "terminal": {
    "shell": {
      "program": "fish",
    },
    "font_size": 17,
    "font_weight": 400.0,
    "line_height": "standard",
    "copy_on_select": true,
    "keep_selection_on_copy": false,
  },

  // Remote
  "ssh_connections": [
    {
      "host": "minilab",
      "args": [],
      "projects": [
        {
          "paths": ["/home/dev/mini-lab"],
        },
      ],
    },
  ],

  // AI
  "disable_ai": false,
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "Haimaker",
      "model": "meta/muse-spark-1.3-contributor",
      "enable_thinking": true,
      "effort": "max",
    },
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-terra",
    },
    "model_parameters": [],
    "use_modifier_to_send": true,
    "show_turn_stats": true,
    "play_sound_when_agent_done": "when_hidden",
    "enable_feedback": false,
    "tool_permissions": {
      "tools": {
{{- if $secrets }}
        "mcp:n8n-mcp:*": { "default": "allow" },
        "mcp:n8n-mcp:get_node_types": { "default": "allow" },
        "mcp:n8n-mcp:get_workflow_execution": { "default": "allow" },
        "mcp:n8n-mcp:publish_workflow": { "default": "allow" },
        "mcp:n8n-mcp:test_workflow": { "default": "allow" },
        "mcp:n8n-mcp:update_workflow": { "default": "allow" },
{{- end }}
        "fetch": {
          "default": "allow",
          "always_allow": [
            { "pattern": "^https?://sveltiacms\\.app" },
            { "pattern": "^https?://api\\.github\\.com" },
          ],
        },
      },
    },
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "antigravity-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "custom",
      "command": "claude-agent-acp",
      "default_config_options": {
        "model": "opus",
        "effort": "high",
        "mode": "auto",
        "fast": false,
      },
      "favorite_config_option_values": {
        "model": ["opus"],
        "mode": ["auto"],
      },
    },
  },
{{- if $secrets }}
  "context_servers": {
    // n8n on tortila. The token is in .secrets/n8n-mcp-token.age.
    "n8n-mcp": {
      "enabled": true,
      "url": "https://n8n.shorthair-inconnu.ts.net/mcp-server/http",
      "headers": {
        "Authorization": "Bearer {{ include ".secrets/n8n-mcp-token.age" | decrypt | trim }}",
      },
    },
  },
{{- end }}
