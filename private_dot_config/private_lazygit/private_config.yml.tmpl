# Defaults: `lazygit -c`. The editor comes from $EDITOR.
gui:
  nerdFontsVersion: "3" # file icons (Symbols Nerd Font fills in the glyphs)
git:
  # delta's theme comes from ~/.config/git/config; its line numbers open the
  # file in $EDITOR at that line when clicked.
{{- if eq .chezmoi.hostname "malvina" }}
  # malvina's lazygit is 0.56; git.pagers became git.diffRenderers in 0.64.
  pagers:
    - colorArg: always
      pager: delta --paging=never --hyperlinks --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
{{- else }}
  diffRenderers:
    - colorArg: always
      command: delta --paging=never --hyperlinks --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
{{- end }}
