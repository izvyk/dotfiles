# Works on tmux 3.4 (Ubuntu 24.04) and newer. No plugin manager: the few
# settings worth having from tmux-sensible, tmux-yank and the gruvbox theme are
# inline, so nothing is cloned from GitHub at startup.

# Terminal: truecolor in ghostty (and xterm-256color, which ghostty sets over
# ssh); clipboard is on by default for xterm*. Copying in copy mode
# or with the mouse goes to the system clipboard via OSC 52, over ssh as well.
# Programs inside tmux can't set the clipboard or pass escape sequences through
# to the terminal (set-clipboard external, allow-passthrough off: the defaults).
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-ghostty:RGB,xterm-256color:RGB"
# No extended-keys: with them Ghostty sends Ctrl+Ц as "Ctrl+ц" instead of ^W,
# so Ctrl shortcuts break on the Russian layout. Shift+Enter still works: Ghostty
# sends it as Alt+Enter (see its config).
set -s escape-time 10     # Esc reaches vim at once, not after 500ms
set -g focus-events on
set -g history-limit 50000
set -g display-time 2000
set -g mouse on
set -g detach-on-destroy off  # closing a session's last window moves to another session
setw -g aggressive-resize on  # a smaller client only shrinks the window it's looking at

# Terminal title: session and window
set -g set-titles on
set -g set-titles-string "#S: #W"

# Windows and panes count from 1, named after the directory at a shell prompt
# and the command while one runs
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
setw -g automatic-rename-format "#{?#{m:*sh,#{pane_current_command}},#{b:pane_current_path},#{pane_current_command}}"

# New windows and panes open in the current directory
bind -N "New window in the current directory" c new-window -c "#{pane_current_path}"
bind -N "Split top/bottom in the current directory" '"' split-window -v -c "#{pane_current_path}"
bind -N "Split left/right in the current directory" % split-window -h -c "#{pane_current_path}"

# Pane navigation: prefix + hjkl. No Alt + arrows: fish uses them (previous/
# next directory or word, history search for the token).
# prefix ? lists all bindings (these with their notes), prefix / describes a key.
bind -N "Select the pane to the left" h select-pane -L
bind -N "Select the pane below" j select-pane -D
bind -N "Select the pane above" k select-pane -U
bind -N "Select the pane to the right (last window moved to Tab)" l select-pane -R
bind -N "Last window" Tab last-window

bind -N "Reload tmux.conf" r source-file ~/.config/tmux/tmux.conf \; display "tmux.conf reloaded"

# Copy mode: vi keys, v selects, C-v toggles a block, y copies and exits
setw -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi C-v send -X rectangle-toggle
bind -T copy-mode-vi y send -X copy-selection-and-cancel
# Esc clears the selection, or leaves copy mode when nothing is selected
bind -T copy-mode-vi Escape if -F "#{selection_present}" { send -X clear-selection } { send -X cancel }

# Selecting with the mouse (drag, double-click a word, triple-click a line)
# doesn't copy: y or right-click copies, q leaves without copying.
unbind -T copy-mode-vi MouseDragEnd1Pane
bind -T copy-mode-vi DoubleClick1Pane { select-pane ; send -X select-word }
bind -T copy-mode-vi TripleClick1Pane { select-pane ; send -X select-line }
bind -n DoubleClick1Pane {
  select-pane -t=
  if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send -M } { copy-mode -H ; send -X select-word }
}
bind -n TripleClick1Pane {
  select-pane -t=
  if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send -M } { copy-mode -H ; send -X select-line }
}

# Colours from the shared theme (.chezmoidata/theme.toml), transparent status bar
{{- with .theme.ui }}
set -g status-style "bg=default,fg={{ .fg_dim }}"
set -g status-left "#[bg={{ .fg_dim }},fg={{ .bg }},bold] #S #[default] "
set -g status-left-length 30
set -g status-right "#[fg={{ .bg4 }}]#h  #[fg={{ .fg_dim }}]%d.%m.%Y %H:%M "
setw -g window-status-format " #I:#W "
setw -g window-status-current-format "#[bg={{ .bg2 }},fg={{ .accent }},bold] #I:#W#{?window_zoomed_flag, (zoom),} "
set -g pane-border-style "fg={{ .bg2 }}"
set -g pane-active-border-style "fg={{ .accent }}"
set -g message-style "bg={{ .accent }},fg={{ .bg }}"
set -g mode-style "bg={{ .bg2 }},fg={{ .fg }}"
{{- end }}

# Right-click in a pane copies or pastes, like Ghostty's right-click-action
# outside tmux: copies the copy-mode selection if there is one, else pastes the
# clipboard (bracketed, so a shell doesn't run pasted lines). Programs that use
# the mouse (vim, htop) still get the click. The pane menu is on Alt+right-click
# (tmux's own binding); the status bar keeps its right-click menus.
bind -n MouseDown3Pane {
  if -F -t= "#{mouse_any_flag}" { select-pane -t= ; send -M } {
    if -F -t= "#{selection_present}" { send -X -t= copy-selection-and-cancel } {
      select-pane -t=
      if -F -t= "#{pane_in_mode}" { send -X -t= cancel }
      run -b -t= 'wl-paste -n -t text | tmux load-buffer -b clipboard - && tmux paste-buffer -p -d -b clipboard -t "#{pane_id}"'
    }
  }
}

# Right-click menus stay open after a click (by default they close on release
# unless you drag onto an item). Rewrites tmux's own menu bindings with -O.
run 'f="${XDG_RUNTIME_DIR:?}/tmux-menus.conf"; tmux list-keys -T root | sed -n "s/display-menu -T/display-menu -O -T/p" > "$f" && tmux source-file "$f"'
