// Press for the third layer (sticky)
// Press twice and hold for the next layout (while pressed)
partial modifier_keys
xkb_symbols "ralt_latch_switch" {
  key <RALT> {
    type[group1]="THREE_LEVEL",
    symbols[Group1] = [ ISO_Level3_Latch, ISO_Level3_Latch, NoSymbol ],
    actions[Group1] = [
        LatchMods(modifiers=LevelThree,clearLocks,latchToLock),
        LatchMods(modifiers=LevelThree,clearLocks,latchToLock),
        SetGroup(group=+1)
    ]
  };
  modifier_map Mod5 { ISO_Level3_Latch };
};

