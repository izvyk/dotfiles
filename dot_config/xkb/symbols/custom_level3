// Press for the third layer (sticky)
// Press twice and for the next layout (permanent)
partial modifier_keys
xkb_symbols "ralt_latch_next" {
  key <RALT> {[  ISO_Level3_Latch,  ISO_Level3_Latch,    ISO_Next_Group  ],
                 type[group1]="THREE_LEVEL" };
  modifier_map Mod5 { ISO_Level3_Latch };
};

// Press for the third layer (sticky)
// Press twice and hold for Alt_R
partial modifier_keys
xkb_symbols "ralt_latch_ralt" {
  key <RALT> {
    type[group1]="THREE_LEVEL",
    symbols[Group1] = [ ISO_Level3_Latch, ISO_Level3_Latch, Alt_R ],
    actions[Group1] = [
        LatchMods(modifiers=LevelThree,clearLocks,latchToLock),
        LatchMods(modifiers=LevelThree,clearLocks,latchToLock),
        SetMods(modifiers=Mod1)
    ]
  };
  // key <RALT> {[  ISO_Level3_Latch, ISO_Level3_Latch  ]};
  modifier_map Mod5 { ISO_Level3_Latch };
};
