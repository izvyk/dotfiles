#!/usr/bin/env bash

(
  # Lock file for debouncing
  flock -n 9 || exit 0

  # Displays to adjust: the monitor under the pointer, from the pointer-monitor
  # GNOME extension (several connectors if mirrored). Without it (sway, or the
  # extension not loaded) fall back to the lid: open -> panel, closed -> externals.
  connectors=($(busctl --user call org.gnome.Shell /org/gnome/Shell/Extensions/PointerMonitor \
      org.gnome.Shell.Extensions.PointerMonitor GetConnectors 2>/dev/null | cut -d' ' -f3- | tr -d '"'))
  lid=open
  grep -iq "closed" /proc/acpi/button/lid/*/state 2>/dev/null && lid=closed

  # External monitors are addressed by I2C bus, read from sysfs. That skips
  # ddcutil's display detection, and --skip-ddc-checks its per-call probing:
  # ~400ms -> ~120ms per step.
  # DP exposes its AUX bus as an i2c-N child; HDMI only has the ddc link.
  panel= buses=()
  for c in /sys/class/drm/card*-*; do
      conn=${c##*/}; conn=${conn#card*-}
      [[ "$(cat "$c/status" 2>/dev/null)" == connected ]] || continue
      if (( ${#connectors[@]} )); then
          [[ " ${connectors[*]} " == *" $conn "* ]] || continue
      elif [[ $lid == open ]]; then
          [[ $conn == eDP-* ]] || continue
      else
          [[ $conn == eDP-* ]] && continue
      fi
      if [[ $conn == eDP-* ]]; then panel=1; continue; fi
      aux=("$c"/i2c-*)
      if [[ -e ${aux[0]} ]]; then bus=${aux[0]}; else bus="$(readlink -f "$c/ddc")"; fi
      [[ -n $bus ]] && buses+=("${bus##*i2c-}")
  done
  ddc() { ddcutil --bus "$1" --skip-ddc-checks "${@:2}"; }

  # Fetch current software brightness
  SW_BRIGHTNESS="$(busctl --user get-property rs.wl-gammarelay / rs.wl.gammarelay Brightness 2>/dev/null || echo 'd 1')"

  # Check if software brightness is at its maximum (1)
  if [[ "$SW_BRIGHTNESS" == "d 1" ]]; then

      # We are out of software dimming mode. Increase the picked displays
      # in parallel, the internal one smoothly.
      [[ -n $panel ]] && brillo -qA 2 -u 200000 &
      for bus in "${buses[@]}"; do
          ddc "$bus" setvcp 10 + 5 --noverify &
      done
      wait
      
  else
      
      # Software brightness is less than 1. Hardware is effectively at 0%.
      # Increase software brightness instead.
      busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateBrightness d 0.01 2>/dev/null || true
      
  fi
  
) 9>"${XDG_RUNTIME_DIR:?}/brightness-throttle.lock"
